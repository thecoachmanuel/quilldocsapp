# OpenRouter AI (High-speed multi-model inference)
OPENROUTER_API_KEY=
AI_MODEL=google/gemini-2.5-flash

# (Optional) Direct OpenAI API Key
OPENAI_API_KEY=

# Kinde Authentication
# On Vercel, set KINDE_SITE_URL and REDIRECT_URLs to your production Vercel domain
KINDE_CLIENT_ID=
KINDE_CLIENT_SECRET=
KINDE_ISSUER_URL=https://quilldocsapp.kinde.com
KINDE_SITE_URL=http://localhost:3000
KINDE_POST_LOGOUT_REDIRECT_URL=http://localhost:3000
KINDE_POST_LOGIN_REDIRECT_URL=http://localhost:3000/dashboard

# Database (MongoDB Atlas)
DATABASE_URL=mongodb+srv://<username>:<password>@cluster0.mongodb.net/quilldocs?retryWrites=true&w=majority

# Uploadthing (Required for Vercel deployment - get free keys at https://uploadthing.com)
UPLOADTHING_SECRET=
UPLOADTHING_APP_ID=

# Pinecone (Vector database for AI document search)
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=
PINECONE_PROJECT_ID=
PINECONE_INDEX_HOST=

# Paystack Payment Gateway (Primary: NGN cards, bank transfer, USSD, and international cards)
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_PRO_AMOUNT_KOBO=1800000

# Stripe (Optional secondary fallback)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
